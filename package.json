{
  "name": "dev tools",
  "displayName": "Dev Tools",
  "description": "Offline-first, high-utility developer Swiss Army Knife with seamless Persian (RTL) & English (LTR) bilingual support.",
  "version": "1.0.0",
  "publisher": "Danial031",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danyal031/DevPulse"
  },
  "bugs": {
    "url": "https://github.com/danyal031/DevPulse/issues"
  },
  "homepage": "https://github.com/danyal031/DevPulse#readme",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "persian",
    "jalali",
    "jwt",
    "zod",
    "port-killer",
    "offline",
    "farsi",
    "json-to-typescript",
    "devpulse"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:devpulse.sidebarView",
    "onCommand:devpulse.openSidebar",
    "onCommand:devpulse.normalizePersianSelection",
    "onCommand:devpulse.convertToJalali",
    "onCommand:devpulse.generateUuid",
    "onCommand:devpulse.generateSecret",
    "onCommand:devpulse.jsonToTypescript",
    "onCommand:devpulse.killPort"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devpulse-activitybar",
          "title": "DevPulse (دِوپالس)",
          "icon": "media/devpulse-icon.svg"
        }
      ]
    },
    "views": {
      "devpulse-activitybar": [
        {
          "type": "webview",
          "id": "devpulse.sidebarView",
          "name": "DevPulse",
          "icon": "media/devpulse-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "devpulse.openSidebar",
        "title": "Open Developer Swiss Army Knife",
        "category": "DevPulse"
      },
      {
        "command": "devpulse.normalizePersianSelection",
        "title": "Normalize Persian Text & Digits in Selection",
        "category": "DevPulse"
      },
      {
        "command": "devpulse.convertToJalali",
        "title": "Convert Date or Timestamp to Jalali",
        "category": "DevPulse"
      },
      {
        "command": "devpulse.generateUuid",
        "title": "Generate UUID v4 at Cursor",
        "category": "DevPulse"
      },
      {
        "command": "devpulse.generateSecret",
        "title": "Generate 64-Byte Secure Secret",
        "category": "DevPulse"
      },
      {
        "command": "devpulse.jsonToTypescript",
        "title": "Convert Selected JSON to TypeScript & Zod",
        "category": "DevPulse"
      },
      {
        "command": "devpulse.killPort",
        "title": "Kill Process on Port...",
        "category": "DevPulse"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "devpulse.normalizePersianSelection",
          "when": "editorHasSelection",
          "group": "devpulse@1"
        },
        {
          "command": "devpulse.jsonToTypescript",
          "when": "editorHasSelection",
          "group": "devpulse@2"
        },
        {
          "command": "devpulse.convertToJalali",
          "when": "editorHasSelection",
          "group": "devpulse@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js --production",
    "test": "node -e \"require('esbuild').buildSync({entryPoints: ['test/testRunner.ts'], outfile: 'test/testBundle.tmp.js', bundle: true, platform: 'node', format: 'cjs'}); require('./test/testBundle.tmp.js'); require('fs').unlinkSync('./test/testBundle.tmp.js');\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.20.1",
    "typescript": "^5.3.3"
  }
}