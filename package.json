{
  "name": "devshelf",
  "displayName": "DevShelf (دِوشلف)",
  "description": "Offline-first, high-utility developer Swiss Army Knife with seamless Persian (RTL) & English (LTR) bilingual support.",
  "version": "1.7.4",
  "publisher": "danial031",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danyal031/DevPulse"
  },
  "bugs": {
    "url": "https://github.com/danyal031/DevPulse/issues"
  },
  "homepage": "https://github.com/danyal031/DevPulse#readme",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "persian",
    "jalali",
    "jwt",
    "zod",
    "port-killer",
    "offline",
    "farsi",
    "json-to-typescript",
    "json-formatter",
    "commit-generator",
    "git-wizard",
    "git-cheat-sheet",
    "docker",
    "api-tester",
    "curl",
    "sql-generator",
    "log-analyzer",
    "mock-server",
    "webhook",
    "tunnel",
    "qr-code",
    "system-monitor",
    "process-killer",
    "load-tester",
    "benchmarking",
    "stress-test",
    "rps",
    "code-snapshot",
    "rayso",
    "carbon",
    "command-center",
    "scripts-runner",
    "css-toolkit",
    "glassmorphism",
    "tailwind-colors",
    "mobile-preview",
    "cache-cleaner",
    "node_modules-cleaner",
    "bundle-size",
    "bundlephobia",
    "package-diet",
    "import-cost",
    "dependency-analyzer",
    "speed-test",
    "bandwidth",
    "ping",
    "jitter",
    "cloudflare-speed",
    "devshelf"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:devshelf.sidebarView",
    "onCommand:devshelf.openSidebar",
    "onCommand:devshelf.normalizePersianSelection",
    "onCommand:devshelf.convertToJalali",
    "onCommand:devshelf.generateUuid",
    "onCommand:devshelf.generateSecret",
    "onCommand:devshelf.jsonToTypescript",
    "onCommand:devshelf.formatJson",
    "onCommand:devshelf.killPort",
    "onCommand:devshelf.copySystemIp",
    "onCommand:devshelf.generateCommitMessage",
    "onCommand:devshelf.openGitWizard",
    "onCommand:devshelf.gitCheatSheet",
    "onCommand:devshelf.openDockerDeck",
    "onCommand:devshelf.openApiTester",
    "onCommand:devshelf.openSqlPlayground",
    "onCommand:devshelf.openLogAnalyzer",
    "onCommand:devshelf.openMockServer",
    "onCommand:devshelf.openTunnel",
    "onCommand:devshelf.openSystemMonitor",
    "onCommand:devshelf.openLoadTester",
    "onCommand:devshelf.openSnapshotStudio",
    "onCommand:devshelf.openCommandCenter",
    "onCommand:devshelf.openCssDesigner",
    "onCommand:devshelf.openCacheCleaner",
    "onCommand:devshelf.openMobilePreview",
    "onCommand:devshelf.openBundleRadar",
    "onCommand:devshelf.openSpeedTest"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devshelf-activitybar",
          "title": "DevShelf (دِوشلف)",
          "icon": "media/devshelf-icon.svg"
        }
      ]
    },
    "views": {
      "devshelf-activitybar": [
        {
          "type": "webview",
          "id": "devshelf.sidebarView",
          "name": "DevShelf",
          "icon": "media/devshelf-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "devshelf.openSidebar",
        "title": "Open Developer Swiss Army Knife",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.normalizePersianSelection",
        "title": "Normalize Persian Text & Digits in Selection",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.convertToJalali",
        "title": "Convert Date or Timestamp to Jalali",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.generateUuid",
        "title": "Generate UUID v4 at Cursor",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.generateSecret",
        "title": "Generate 64-Byte Secure Secret",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.jsonToTypescript",
        "title": "Convert Selected JSON to TypeScript & Zod",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.formatJson",
        "title": "Format JSON in Selection",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.killPort",
        "title": "Kill Process on Port...",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.copySystemIp",
        "title": "Copy Local System IP",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.generateCommitMessage",
        "title": "Generate Conventional Commit Message",
        "category": "DevShelf",
        "icon": {
          "light": "media/commit-icon-light.svg",
          "dark": "media/commit-icon-dark.svg"
        }
      },
      {
        "command": "devshelf.openGitWizard",
        "title": "Open Git Command Wizard",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.gitCheatSheet",
        "title": "Git Rescue Cheat Sheet",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openDockerDeck",
        "title": "Open Docker Quick Deck",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openApiTester",
        "title": "Open Mini API Tester",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openSqlPlayground",
        "title": "Open SQL Query & Schema Playground",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openLogAnalyzer",
        "title": "Open Log File Analyzer & Highlighter",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openMockServer",
        "title": "Open Mock Server & Webhook Catcher",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openTunnel",
        "title": "Open Public Tunnel & QR Share",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openSystemMonitor",
        "title": "Open System Resource Monitor & Zombie Killer",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openLoadTester",
        "title": "Open Mini Load Tester & API Stress Benchmarker",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openSnapshotStudio",
        "title": "Open Code-to-Image & Snapshot Studio",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openCommandCenter",
        "title": "Open 1-Click Project Command Center",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openCssDesigner",
        "title": "Open Frontend & CSS Live Design Toolkit",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openCacheCleaner",
        "title": "Open Dev Junk & Cache Obliterator",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openMobilePreview",
        "title": "Open Responsive Multi-Device Preview Panel",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openBundleRadar",
        "title": "Open Bundle Size Radar & Package Diet",
        "category": "DevShelf"
      },
      {
        "command": "devshelf.openSpeedTest",
        "title": "Open Internet Speed Test (Ping, Jitter, Download, Upload)",
        "category": "DevShelf"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "devshelf.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "scm/inputBox": [
        {
          "command": "devshelf.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "devshelf.normalizePersianSelection",
          "when": "editorHasSelection",
          "group": "devshelf@1"
        },
        {
          "command": "devshelf.formatJson",
          "when": "editorHasSelection",
          "group": "devshelf@2"
        },
        {
          "command": "devshelf.jsonToTypescript",
          "when": "editorHasSelection",
          "group": "devshelf@3"
        },
        {
          "command": "devshelf.convertToJalali",
          "when": "editorHasSelection",
          "group": "devshelf@4"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js --production",
    "test": "node -e \"require('esbuild').buildSync({entryPoints: ['test/testRunner.ts'], outfile: 'test/testBundle.tmp.js', bundle: true, platform: 'node', format: 'cjs', alias: {'vscode': './test/mockVscode.ts'}}); require('./test/testBundle.tmp.js'); require('fs').unlinkSync('./test/testBundle.tmp.js');\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.20.1",
    "typescript": "^5.3.3"
  }
}
